{
	"tasks": {
		"dev": "cd src; python3 -m http.server",
		"serve": "cd dist; python3 -m http.server 8001",
		"build": "deno --allow-read --allow-write --allow-env build.js",
		"generate": "deno --allow-run generate-preloads.js"
	},
	"imports": {
		"@std/dotenv": "jsr:@std/dotenv@^0.225.0",
		"@std/path": "jsr:@std/path@^1.1.0",
		"q/": "https://cdn.we-evolve.co.uk/js/q/v1.1.1/",
		"utils/": "./src/js/utils/",
		"components/": "./src/js/components/",
		"mambo/": "./src/js/modules/mambo/",
		"menu/": "./src/js/modules/menu/",
		"migrations/": "./src/js/migrations/",
		"queens/": "./src/js/modules/queens/",
		"swordle/": "./src/js/modules/swordle/"
	},
	"lint": {
		"include": ["src/"],
		"rules": {
			"include": ["no-console"],
			"exclude": ["no-window-prefix", "no-window"]
		}
	}
}
